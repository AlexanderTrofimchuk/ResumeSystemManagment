@using Microsoft.AspNetCore.Mvc.Localization
@model ResumeSystemManagement.Web.ViewModels.PaginationViewModel
@inject IViewLocalizer Localizer

@if (Model.TotalPages > 1)
{
    var firstPageRoutes = new Dictionary<string, string>(Model.RouteValues)
    {
        [Model.PageParameterName] = "1"
    };
    var previousPageRoutes = new Dictionary<string, string>(Model.RouteValues)
    {
        [Model.PageParameterName] = (Model.CurrentPage - 1).ToString()
    };
    var nextPageRoutes = new Dictionary<string, string>(Model.RouteValues)
    {
        [Model.PageParameterName] = (Model.CurrentPage + 1).ToString()
    };
    var lastPageRoutes = new Dictionary<string, string>(Model.RouteValues)
    {
        [Model.PageParameterName] = Model.TotalPages.ToString()
    };
    var startPage = Math.Max(1, Model.CurrentPage - 2);
    var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

    <nav aria-label="@Localizer["Pagination"]" class="mt-3">
        <ul class="pagination pagination-sm justify-content-center flex-wrap">
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-controller="@Model.Controller"
                   asp-action="@Model.Action"
                   asp-all-route-data="@firstPageRoutes"
                   aria-label="@Localizer["First"]">
                    <i class="bi bi-chevron-double-left" aria-hidden="true"></i>
                </a>
            </li>
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-controller="@Model.Controller"
                   asp-action="@Model.Action"
                   asp-all-route-data="@previousPageRoutes"
                   aria-label="@Localizer["Previous"]">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                </a>
            </li>

            @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
            {
                var pageRoutes = new Dictionary<string, string>(Model.RouteValues)
                {
                    [Model.PageParameterName] = pageNumber.ToString()
                };
                <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : "")">
                    @{ var number = pageNumber; }
                    <a class="page-link"
                       asp-controller="@Model.Controller"
                       asp-action="@Model.Action"
                       asp-all-route-data="@pageRoutes"
                       aria-current="@(number == Model.CurrentPage ? "page" : null)">
                        @number
                    </a>
                </li>
            }

            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-controller="@Model.Controller"
                   asp-action="@Model.Action"
                   asp-all-route-data="@nextPageRoutes"
                   aria-label="@Localizer["Next"]">
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </a>
            </li>
            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-controller="@Model.Controller"
                   asp-action="@Model.Action"
                   asp-all-route-data="@lastPageRoutes"
                   aria-label="@Localizer["Last"]">
                    <i class="bi bi-chevron-double-right" aria-hidden="true"></i>
                </a>
            </li>
        </ul>
    </nav>

    <p class="text-center text-muted small">
        @Localizer["PageSummary", Model.CurrentPage, Model.TotalPages, Model.TotalCount]
    </p>
}
