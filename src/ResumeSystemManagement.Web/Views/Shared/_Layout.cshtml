@using Microsoft.AspNetCore.Mvc.Localization
@using ResumeSystemManagement.Core.ReadModels
@inject IViewLocalizer Localizer
@{
    var uiCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var isGerman = uiCulture.StartsWith("de", StringComparison.OrdinalIgnoreCase);
    var targetCulture = isGerman ? "en-US" : "de-DE";
}
<!DOCTYPE html>
<html lang="@(uiCulture.StartsWith("de", StringComparison.OrdinalIgnoreCase) ? "de" : "en")">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/responsive.shared.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/responsive.login.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/responsive.registration.css" asp-append-version="true"/>
    @await RenderSectionAsync("Styles", required: false)
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Roboto+Mono:ital,wght@0,100..700;1,100..700&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ResumeSystem</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="@Localizer["ToggleNavigation"]">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-collapse collapse justify-content-between" id="navbarSupportedContent">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-action="Index" asp-controller="Position">@Localizer["Positions"]</a>
                    </li>
                    @if (User.IsInRole(RoleNames.Recruiter) || User.IsInRole(RoleNames.Administrator))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-action="Index" asp-controller="AttributeLibrary">@Localizer["AttributeLibrary"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark">@Localizer["Cvs"]</a>
                        </li>
                    }
                    @if (User.IsInRole(RoleNames.Administrator))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-action="UserManagement" asp-controller="Admin">@Localizer["Users"]</a>
                        </li>
                    }
                </ul>
                
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <form asp-controller="Language" asp-action="SetLanguage" method="post">
                            <input type="hidden" name="culture" value="@targetCulture"/>
                            <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")"/>
                            <button type="submit" class="nav-link text-dark border-0 bg-transparent">
                                @Localizer[isGerman ? "English" : "German"]
                            </button>
                        </form>
                    </li>
                    <li class="nav-item" style="display: @(User.Identity!.IsAuthenticated ? "none" : "block"); ">
                        <a class="nav-link text-dark" id="login" asp-action="LoginPage" asp-controller="Account">@Localizer["Login"]</a>
                    </li>
                    <li class="nav-item" style="display: @(User.Identity!.IsAuthenticated ? "none" : "block"); ">
                        <a class="nav-link text-dark" id="registration" asp-action="RegisterPage" asp-controller="Account">@Localizer["Register"]</a>
                    </li>
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" id="profile" asp-action="Profile" asp-controller="Profile">@Localizer["Profile"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" id="logout" asp-action="Logout" asp-controller="Account">@Localizer["Logout"]</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container-fluid p-0">
    <main role="main">
        @RenderBody()
    </main>
</div>

<partial name="_Notification"/>
<footer>
    @if(User.Identity!.IsAuthenticated)
    {
        <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#supportTicketModal">
            Help
        </button>
        <partial name="_SupportTicketModal" model="new ResumeSystemManagement.Application.DTOs.Ticket.SupportTicket()"/>
    }
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/editAttribute.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>