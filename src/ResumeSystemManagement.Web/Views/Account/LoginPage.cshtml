@using Microsoft.AspNetCore.Mvc.Localization
@model ResumeSystemManagement.Web.ViewModels.LoginViewModel
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"];
}

@section Styles
{
    <link rel="stylesheet" href="~/css/responsive.login.css" asp-append-version="true"/>
}

<div class="container-fluid p-0 robot-mono-font">
  <div class="d-flex flex-column justify-content-center align-items-center position-relative login-center">
    <div class="login-form-box shadow p-3 mb-5 bg-body-tertiary rounded">
      <h2 class="mb-3 login-heading text-center">@Localizer["SignInHeading"]</h2>
      <form
        asp-antiforgery="true"
        asp-action="LoginUser"
        asp-controller="Account"
        class="login-form px-4"
        novalidate
      >
        <div class="mb-2">
          <label asp-for="Email" class="form-label mb-1"><b>@Localizer["EmailLabel"]</b></label>
          <input
            asp-for="Email"
            class="form-control form-control-sm border-black login-input"
            type="text"
            placeholder="@Localizer["EmailPlaceholder"]"
          />
          <span
            asp-validation-for="Email"
            class="text-danger"
            style="font-size: 0.8em"
          ></span>
        </div>

        <div class="mb-3">
          <label asp-for="Password" class="form-label mb-1"><b>@Localizer["PasswordLabel"]</b></label>
          <div class="input-group">
            <input
              asp-for="Password"
              class="form-control form-control-sm border-black login-input"
              type="password"
              maxlength="12"
              placeholder="@Localizer["PasswordPlaceholder"]"
            />
            <button
              class="btn btn-outline-secondary btn-sm"
              type="button"
              id="togglePassword"
            >
              <i class="bi bi-eye" id="toggleIcon"></i>
            </button>
          </div>
          <span
            asp-validation-for="Password"
            class="text-danger"
            style="font-size: 0.8em"
          ></span>
        </div>

        <a
          href="#"
          data-bs-toggle="modal"
          data-bs-target="#forgotPasswordModal"
          class="text-primary text-decoration-none d-block mt-2 mb-3 login-forgot"
        >
          @Localizer["ForgotPasswordLink"]
        </a>

        <div class="d-grid gap-2">
          <button
            type="submit"
            class="btn btn-primary btn-sm robot-mono-font login-btn-submit"
          >
            @Localizer["SignInButton"]
          </button>
          <a
            class="btn btn-outline-primary btn-sm login-btn-submit"
            type="button"
            asp-controller="OAuth"
            asp-action="GoogleLogin"
          >
            <i class="bi bi-google"></i> @Localizer["GoogleSignInButton"]
          </a>
          <a
            class="btn btn-outline-primary btn-sm login-btn-submit"
            type="button"
            asp-controller="OAuth"
            asp-action="FacebookLogin"
          >
              <i class="bi bi-facebook"></i> @Localizer["FacebookSignInButton"]
          </a>
        </div>
      </form>

      <p class="login-footer-text mt-3 mb-0 text-center">
          @Localizer["NoAccountText"]
          <a asp-action="RegisterPage" asp-controller="Account">@Localizer["SignUpLink"]</a>
      </p>
    </div>
  </div>
</div>

<div class="modal fade" id="forgotPasswordModal" tabindex="-1"
     aria-labelledby="forgotPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content robot-mono-font">

            <div class="modal-header">
                <h5 class="modal-title" id="forgotPasswordModalLabel">@Localizer["ChangePasswordModalTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="ChangePassword" asp-controller="Account" novalidate>
                <div class="modal-body">

                    <div class="mb-3">
                        <label asp-for="ChangePassword!.Email" class="form-label"><b>@Localizer["EmailLabel"]</b></label>
                        <input asp-for="ChangePassword!.Email"
                               type="text"
                               class="form-control border-black"
                               placeholder="@Localizer["ModalEmailPlaceholder"]">
                        <span asp-validation-for="ChangePassword!.Email" class="text-danger" style="font-size: 0.875em;"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ChangePassword!.OldPassword" class="form-label"><b>@Localizer["OldPasswordLabel"]</b></label>
                        <div class="input-group">
                            <input asp-for="ChangePassword!.OldPassword"
                                   type="password"
                                   class="form-control border-black"
                                   maxlength="12"
                                   placeholder="@Localizer["OldPasswordPlaceholder"]">
                            <button class="btn btn-outline-secondary"
                                    type="button"
                                    id="toggleOldPassword">
                                <i class="bi bi-eye" id="toggleOldPasswordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ChangePassword!.OldPassword" class="text-danger" style="font-size: 0.875em;"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ChangePassword!.NewPassword" class="form-label"><b>@Localizer["NewPasswordLabel"]</b></label>
                        <div class="input-group">
                            <input asp-for="ChangePassword!.NewPassword"
                                   type="password"
                                   class="form-control border-black"
                                   maxlength="12"
                                   placeholder="@Localizer["NewPasswordPlaceholder"]">
                            <button class="btn btn-outline-secondary"
                                    type="button"
                                    id="toggleChangePassword">
                                <i class="bi bi-eye" id="toggleChangePasswordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ChangePassword!.NewPassword" class="text-danger" style="font-size: 0.875em;"></span>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["CancelButton"]</button>
                    <button type="submit" class="btn btn-primary">@Localizer["ChangePasswordButton"]</button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts
{
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/site.js"></script>>
    <script>
        changePasswordIcon('Password', 'toggleIcon', 'togglePassword');
        changePasswordIcon('ChangePassword_OldPassword', 'toggleOldPasswordIcon', 'toggleOldPassword');
        changePasswordIcon('ChangePassword_NewPassword', 'toggleChangePasswordIcon', 'toggleChangePassword');
    </script>
}
