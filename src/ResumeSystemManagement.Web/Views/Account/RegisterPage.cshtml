@model ResumeSystemManagement.Web.ViewModels.RegistrationViewModel
@{
    ViewData["Title"] = "Register";
}

@section Styles {
    <link rel="stylesheet" href="~/css/responsive.registration.css" asp-append-version="true"/>
}

<div class="container-fluid p-0 robot-mono-font">
    <div class="d-flex flex-column justify-content-center align-items-center position-relative login-center">
            <div class="reg-form-box">
                <h2 class="mb-4 reg-heading">Sign up</h2>
                <form asp-antiforgery="true" asp-action="RegisterUser" method="post" class="reg-form" novalidate>
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"><b>Full name</b></label>
                        <input asp-for="FullName"
                               type="text"
                               class="form-control border-black reg-input"
                               placeholder="Enter fullname">
                        <span asp-validation-for="FullName" class="text-danger" style="font-size: 0.875em;"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"><b>Email address</b></label>
                        <input asp-for="Email"
                               type="text"
                               class="form-control border-black reg-input"
                               placeholder="Enter email">
                        <span asp-validation-for="Email" class="text-danger" style="font-size: 0.875em;"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"><b>Password</b></label>
                        <div class="input-group">
                            <input asp-for="Password"
                                   type="password"
                                   class="form-control border-black reg-input"
                                   placeholder="Enter password"
                                   minlength="1"
                                   maxlength="8">
                            <button class="btn btn-outline-secondary"
                                    type="button"
                                    id="togglePassword">
                                <i class="bi bi-eye" id="iconPassword"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger" style="font-size: 0.875em;"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"><b>Confirm Password</b></label>
                        <div class="input-group">
                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-control border-black reg-input"
                                   placeholder="Confirm password"
                                   minlength="1"
                                   maxlength="8">
                            <button class="btn btn-outline-secondary"
                                    type="button"
                                    id="toggleConfirmPassword">
                                <i class="bi bi-eye" id="iconConfirmPassword"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size: 0.875em;"></span>
                    </div>

                    <div class="d-flex justify-content-center">
                        <button type="submit"
                                class="btn btn-primary robot-mono-font reg-btn-submit px-4">
                            Sign up
                        </button>
                    </div>
                </form>
            </div>
            <p class="reg-footer-text mb-0">
                Already have an account?
                <a asp-action="LoginPage" asp-controller="Account">Sign in</a>
            </p>
        </div>
</div>

@section Scripts {
    <script type="module">
        import('/js/site.js').then(m => {
            m.changePasswordIcon('Password', 'toggleIcon', 'togglePassword');
            m.changePasswordIcon('ConfirmPassword', 'iconConfirmPassword', 'toggleConfirmPassword');
        });
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"
            crossorigin="anonymous"
            integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g==">
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"
            crossorigin="anonymous"
            integrity="sha512-rstIgDs0xPgmG6RX1Aba4KV5cWJbAMcvRCVmglpam9SoHZiUCyQVDdH2LPlxoHtrv17XWblE/V/PP+Tr04hbtA==">
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"
            crossorigin="anonymous"
            integrity="sha512-xq+Vm8jC94ynOikewaQXMEkJIOBp7iArs3IhFWSWdRT3Pq8wFz46p+ZDFAR7kHnSFf+zUv52B3prRYnbDRdgog==">
    </script>   
}