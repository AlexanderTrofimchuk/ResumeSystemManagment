<style>
    /* User management: keep the toolbar, table and pagination in normal document flow. */
    .um-container {
        display: block !important;
        width: 100%;
        max-width: 1400px;
        margin-left: auto !important;
        margin-right: auto !important;
    }

    .um-toolbar {
        display: flex !important;
        width: 100%;
        visibility: visible !important;
        opacity: 1 !important;
    }

    .um-table-wrapper {
        display: block !important;
        visibility: visible !important;
        opacity: 1 !important;
        width: 100%;
    }

    .um-scroll-area {
        display: block !important;
        width: 100%;
        overflow-x: auto;
        overflow-y: visible;
    }

    .um-table {
        display: table !important;
        width: 100%;
        min-width: 700px;
    }

    .um-table th,
    .um-table td {
        vertical-align: middle;
    }
</style>

@model ResumeSystemManagement.Application.DTOs.User.UserDetails
@{
    ViewData["Title"] = "Users Control";
}

<div class="container mx-auto justify-content-center align-items-center mt-2 robot-mono-font um-container">
    <div class="toolbar d-flex align-items-center gap-2 p-2 mb-3 border rounded bg-light shadow-sm um-toolbar">

        <button type="button"
                id="btnChange"
                class="btn btn-primary btn-sm" disabled
                title="Change role"
                data-bs-toggle="modal"
                data-bs-target="#changeRoleModal">
            <i class="bi bi-person-gear"></i>
        </button>

        <button asp-action="BlockUsers" asp-controller="Admin"
                form="mainForm"
                id="btnBlock"
                class="btn btn-outline-danger btn-sm" disabled
                title="Block selected user">
            <i class="bi bi-slash-circle"></i>
        </button>

        <button asp-action="UnBlockUsers" asp-controller="Admin"
                form="mainForm"
                id="btnUnblock"
                class="btn btn-success btn-sm" disabled
                title="Unblock selected user">
            <i class="bi bi-unlock"></i>
        </button>

        <button type="submit" asp-action="DeleteUsers" asp-controller="Admin"
                form="mainForm"
                id="btnDelete"
                class="btn btn-danger btn-sm" disabled
                title="Delete selected user">
            <i class="bi bi-trash"></i>
        </button>

    </div>

    <form method="post" id="mainForm">
        <input type="hidden" name="CurrentPage" value="@Model.CurrentPage" />
        <input type="hidden" name="PageSize" value="@Model.PageSize" />
        <div class="um-table-wrapper">
            <div class="um-scroll-area">
                <table class="table table-striped-columns um-table text-center">
                    <thead>
                    <tr>
                        <th scope="col">
                            <input class="form-check-input" type="checkbox" name="selectAll" id="selectAll" aria-label="Select All">
                        </th>
                        <th scope="col">Name</th>
                        <th scope="col">Email</th>
                        <th scope="col">Blocked</th>
                        <th scope="col">Role</th>
                    </tr>
                    </thead>
                    <tbody>
                    @if (Model.UserInfos.Count > 0)
                    {
                        @foreach (var user in Model.UserInfos)
                        {
                            <tr>
                                <td>
                                    <input value="@user.Id"
                                           name="SelectIds"
                                           id="checkbox-@user.Id"
                                           type="checkbox"
                                           class="form-check-input row-checkbox">
                                </td>
                                <td>@user.FullName</td>
                                <td>@user.Email</td>
                                <td>
                                    <input checked="@user.IsBlocked"
                                           id="blocked-checkbox-@user.Id"
                                           type="checkbox"
                                           class="form-check-input"
                                           disabled>
                                </td>
                                <td>@user.Role</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center">
                                <p class="h3 my-3">No users found</p>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </form>

    @await Html.PartialAsync("_ChangeRoleModal", ResumeSystemManagement.Core.ReadModels.RoleNames.Roles)

    @if (Model.TotalPages > 1)
    {
    <nav aria-label="User list pagination" class="mt-3">
        <ul class="pagination pagination-sm justify-content-center flex-wrap">

            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="UserManagement"
                   asp-controller="Admin"
                   asp-route-pageNumber="1"
                   asp-route-pageSize="@Model.PageSize"
                   aria-label="First">
                    <i class="bi bi-chevron-double-left"></i>
                </a>
            </li>

            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="UserManagement"
                   asp-controller="Admin"
                   asp-route-pageNumber="@(Model.CurrentPage - 1)"
                   asp-route-pageSize="@Model.PageSize"
                   aria-label="Previous">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>

            @{
            int startPage = Math.Max(1, Model.CurrentPage - 2);
            int endPage   = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
            }

            @for (int p = startPage; p <= endPage; p++)
            {
            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                <a class="page-link"
                   asp-action="UserManagement"
                   asp-controller="Admin"
                   asp-route-pageNumber="@p"
                   asp-route-pageSize="@Model.PageSize">
                    @p
                </a>
            </li>
            }

            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="UserManagement"
                   asp-controller="Admin"
                   asp-route-pageNumber="@(Model.CurrentPage + 1)"
                   asp-route-pageSize="@Model.PageSize"
                   aria-label="Next">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>

            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="UserManagement"
                   asp-controller="Admin"
                   asp-route-pageNumber="@Model.TotalPages"
                   asp-route-pageSize="@Model.PageSize"
                   aria-label="Last">
                    <i class="bi bi-chevron-double-right"></i>
                </a>
            </li>

        </ul>
    </nav>

    <p class="text-center text-muted small">
        Page @Model.CurrentPage of @Model.TotalPages
        &nbsp;|&nbsp; Total users: @Model.TotalCount
    </p>
    }
</div>

<script>
(function () {
    const selectAll = document.getElementById('selectAll');
    const rowCheckboxes = Array.from(document.querySelectorAll('.row-checkbox'));

    const toolbarButtons = [
        document.getElementById('btnChange'),
        document.getElementById('btnBlock'),
        document.getElementById('btnUnblock'),
        document.getElementById('btnDelete')
    ].filter(Boolean);

    function updateToolbarState() {
        const checked = rowCheckboxes.filter(cb => cb.checked);
        const anyChecked = checked.length > 0;

        toolbarButtons.forEach(btn => {
            btn.disabled = !anyChecked;
        });

        // Changing a role applies to one selected user at a time.
        const changeButton = document.getElementById('btnChange');
        if (changeButton) {
            changeButton.disabled = checked.length !== 1;
        }
    }

    function updateSelectAllState() {
        if (!selectAll) {
            return;
        }

        selectAll.checked =
            rowCheckboxes.length > 0 &&
            rowCheckboxes.every(cb => cb.checked);

        selectAll.indeterminate =
            rowCheckboxes.some(cb => cb.checked) &&
            !selectAll.checked;
    }

    if (selectAll) {
        selectAll.addEventListener('change', function () {
            rowCheckboxes.forEach(cb => {
                cb.checked = this.checked;

                const row = cb.closest('tr');
                if (row) {
                    row.classList.toggle('table-active', this.checked);
                }
            });

            selectAll.indeterminate = false;
            updateToolbarState();
        });
    }

    rowCheckboxes.forEach(cb => {
        cb.addEventListener('change', function () {
            const row = this.closest('tr');

            if (row) {
                row.classList.toggle('table-active', this.checked);
            }

            updateSelectAllState();
            updateToolbarState();
        });
    });

    window.addEventListener('pageshow', (event) => {
        if (event.persisted) {
            rowCheckboxes.forEach(cb => {
                cb.checked = false;

                const row = cb.closest('tr');
                if (row) {
                    row.classList.remove('table-active');
                }
            });

            if (selectAll) {
                selectAll.checked = false;
                selectAll.indeterminate = false;
            }

            updateToolbarState();
        }
    });

    updateSelectAllState();
    updateToolbarState();
})();
</script>
