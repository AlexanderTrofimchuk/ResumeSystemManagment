@model ResumeSystemManagement.Application.DTOs.Attribute.EditAttributeDTo

@{
    ViewData["Title"] = "Edit Attribute";
}

<div class="modal fade" id="editAttributeModal" tabindex="-1"
     aria-labelledby="editAttributeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <div class="modal-header border-bottom px-4 py-3">
                <h5 class="modal-title fw-semibold" id="editAttributeModalLabel">
                    Edit Attribute
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="EditAttribute" method="post" novalidate id="editAttributeForm">
                <div class="modal-body px-4 py-4">
                    <input asp-for="Id" type="hidden" />
                    <input type="hidden" asp-for="IsBuiltIn" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger py-2 small mb-3" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <!-- Category -->
                        <div class="col-sm-6">
                            <label asp-for="CategoryId" class="form-label fw-medium">
                                Category <span class="text-danger">*</span>
                            </label>
                            <select asp-for="CategoryId"
                                    asp-items="ViewBag.Categories"
                                    class="form-select">
                                <option value="">— select —</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <!-- Type -->
                        <div class="col-sm-6">
                            <label asp-for="TypeId" class="form-label fw-medium">
                                Type <span class="text-danger">*</span>
                            </label>
                            <select asp-for="TypeId"
                                    asp-items="ViewBag.Types"
                                    class="form-select"
                                    data-dropdown-type-id="@ViewBag.DropdownTypeId">
                                <option value="">— select —</option>
                            </select>
                            <span asp-validation-for="TypeId" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Title -->
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-medium">
                            Title <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Title"
                               class="form-control"
                               placeholder="Enter attribute title"
                               autocomplete="off" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-medium">Description</label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Brief description (optional)"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <!-- Dropdown Options -->
                    <div class="mb-3 mt-3" id="editDropdownOptionsSection"
                         style="display:@(Model.DropdownOptions != null && Model.DropdownOptions.Any() ? "block" : "none");">
                        <label class="form-label fw-medium">
                            Options <span class="text-danger">*</span>
                        </label>
                        <div id="editDropdownOptionsList" class="d-flex flex-column gap-2 mb-2">
                            @if (Model.DropdownOptions != null)
                            {
                                for (int i = 0; i < Model.DropdownOptions.Count; i++)
                                {
                                    <div class="input-group">
                                        <input type="hidden" name="DropdownOptions[@i].Id" value="@Model.DropdownOptions[i].Id" />
                                        <input type="text"
                                               id="DropdownOptions-@i"
                                               class="form-control"
                                               name="DropdownOptions[@i].Value"
                                               value="@Model.DropdownOptions[i].Value"
                                               placeholder="Option @(i + 1)"
                                               autocomplete="off"/>
                                        <button type="button" class="btn btn-outline-danger remove-edit-option" title="Remove">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="addEditDropdownOption">
                            <i class="bi bi-plus-lg me-1"></i> Add option
                        </button>
                    </div>

                </div>

                <div class="modal-footer border-top px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i> Save
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
