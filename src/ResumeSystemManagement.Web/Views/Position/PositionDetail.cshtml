@using ResumeSystemManagement.Core.Enums
@using ResumeSystemManagement.Core.ReadModels
@model ResumeSystemManagement.Application.DTOs.Position.PositionDetailForUser

@{
    ViewData["Title"] = Model.PositionTitle;
    bool isCandidate = User.IsInRole(RoleNames.Candidate);
}

@section Styles {
  <style>
    .section-header {
      background-color: var(--bs-gray-100);
      border-bottom: 1px solid var(--bs-border-color);
    }
    .attr-row:last-child {
      border-bottom: none !important;
    }
    .section-block {
      border: 1px solid var(--bs-border-color);
      border-radius: .375rem;
      overflow: hidden;
    }
  </style>
}

<!-- Topbar -->
<nav class="navbar bg-body-tertiary border-bottom px-3 py-2">
  <div class="d-flex align-items-center gap-3">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0 small">
        <li class="breadcrumb-item">
          <a asp-controller="Position" asp-action="Index" class="text-muted text-decoration-none">Positions</a>
        </li>
        <li class="breadcrumb-item active fw-semibold">@Model.PositionTitle</li>
      </ol>
    </nav>
  </div>

  @if (isCandidate)
  {
    <div class="d-flex gap-2">
      <a asp-controller="Resume" asp-action="Create" asp-route-positionId="@Model.PositionId"
         class="btn btn-sm btn-primary">
        <i class="bi bi-file-earmark-plus me-1"></i>Create CV
      </a>
      <a asp-controller="Resume" asp-action="Open" asp-route-positionId="@Model.PositionId"
         class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-file-earmark-text me-1"></i>Open CV
      </a>
    </div>
  }
</nav>
<div class="container-fluid py-4 px-4" style="max-width: 780px;">
  
  <h1 class="fs-3 fw-semibold mb-3">@Model.PositionTitle</h1>
  
  <p class="text-secondary mb-4" style="line-height: 1.7;">@Model.Desciption</p>
  <div class="d-flex align-items-center gap-2 mb-4">
    <i class="bi bi-folder-check text-secondary"></i> 
    <span class="small text-secondary"> Required projects: </span> 
    <span class="fw-semibold"> @Model.RequiredProjectCount </span>
  </div>
  
  <p class="text-uppercase text-muted small fw-semibold mb-3" style="letter-spacing: .06em;">
    What to include in your CV
  </p>

  @foreach (var section in Enum.GetValues<TemplateSection>())
  {
    var items = Model.GetAttributes(section);
    if (!items.Any()) { continue; }

    var icon  = section.GetDisplayIcon();
    var label = section.GetDisplayName();

    <div class="section-block mb-3">

      <!-- Section header -->
      <div class="section-header d-flex align-items-center gap-2 px-3 py-2">
        <i class="bi @icon text-secondary"></i>
        <span class="fw-semibold small">@label</span>
        <span class="badge bg-secondary bg-opacity-25 text-secondary fw-normal ms-1" style="font-size: .65rem;">
          @items.Count
        </span>
      </div>

      @foreach (var attr in items)
      {
        <div class="attr-row d-flex align-items-center justify-content-between px-3 py-2 border-bottom bg-white">
          <span class="small">@attr.Name</span>
        </div>
      }

    </div>
  }

</div>
