<style>
    /* Position library: keep the table visible at every screen width. */
    .um-container {
        display: block !important;
        width: 100%;
        max-width: 1400px;
        margin-left: auto !important;
        margin-right: auto !important;
    }

    .um-toolbar {
        width: 100%;
    }

    .um-table-wrapper {
        display: block !important;
        visibility: visible !important;
        opacity: 1 !important;
        width: 100%;
    }

    .um-scroll-area {
        display: block !important;
        width: 100%;
        overflow-x: auto;
        overflow-y: visible;
    }

    .um-table {
        display: table !important;
        width: 100%;
        min-width: 900px;
    }
</style>

@using ResumeSystemManagement.Core.ReadModels
@model ResumeSystemManagement.Application.DTOs.Position.PositionDetails
@{
    ViewData["Title"] = "Position Library";
}

<div class="container mx-auto justify-content-center align-items-center mt-2 robot-mono-font um-container">

    <div class="toolbar d-flex align-items-center gap-2 p-2 mb-3 border rounded bg-light shadow-sm um-toolbar">

        <form asp-controller="Position"
              asp-action="SearchPosition"
              method="get"
              class="d-flex gap-2 flex-grow-1">

            <input type="text"
                   name="name"
                   class="form-control form-control-sm"
                   placeholder="Search by title or description..."
                   aria-label="Search positions"
                   value="@Context.Request.Query["name"]">

            <button type="submit"
                    class="btn btn-outline-secondary btn-sm flex-shrink-0"
                    title="Search">
                <i class="bi bi-search"></i>
            </button>

        </form>
        
        @if (User.IsInRole(RoleNames.Recruiter) || User.IsInRole(RoleNames.Administrator))
        {
            <button
                id="btnCreate"
                class="btn btn-outline-primary btn-sm"
                title="Create position"
                data-bs-toggle="modal"
                data-bs-target="#createPositionModal">
                <span class="btn-text"><i class="bi bi-plus-square-fill"></i></span>
            </button>
            
            <button asp-action="DuplicatePosition"
                    type="submit"
                    form="mainForm"
                    id="btnDuplicate"
                    class="btn btn-outline-warning btn-sm"
                    disabled
                    title="Duplicate position">
                <i class="bi bi-copy"></i>
            </button>
            
            <button
                id="btnEdit"
                class="btn btn-outline-secondary btn-sm"
                disabled
                title="Edit position">
                <i class="bi bi-pencil-fill"></i>
            </button>
            
            <button asp-controller="Position"
                    asp-action="RenderTemplate"
                    type="submit"
                    form="mainForm"
                    id="btnTemplate"
                    class="btn btn-outline-info btn-sm"
                    disabled
                    title="Open template">
                <i class="bi bi-file-earmark-text"></i>
            </button>

            <button asp-action="DeletePositions"
                    type="submit"
                    form="mainForm"
                    id="btnDelete"
                    class="btn btn-outline-danger btn-sm"
                    disabled
                    title="Delete position/positions">
                <i class="bi bi-dash-square-fill"></i>
            </button>
        }

    </div>

    <form method="post" id="mainForm">
        <div class="um-table-wrapper">
            <div class="um-scroll-area">
                <table class="table table-striped-columns um-table text-center">
                    <thead>
                    <tr>
                        <th scope="col">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="selectAll"
                                   id="selectAll"
                                   aria-label="Select All">
                        </th>
                        <th scope="col">Title</th>
                        <th scope="col">Short Description</th>
                        <th scope="col">Level</th>
                        <th scope="col">Permissions</th>
                        <th scope="col">Publish Status</th>
                        <th scope="col">Max Projects</th>
                        <th scope="col">Created On</th>
                        <th scope="col">Closed On</th>
                    </tr>
                    </thead>

                    <tbody id="positionTableBody">
                    @if (Model.Positions.Count > 0)
                    {
                        @foreach (var item in Model.Positions)
                        {
                            <tr class="position-row">
                                <td>
                                    <input value="@item.Id"
                                           name="SelectIds"
                                           id="checkbox-@item.Id"
                                           type="checkbox"
                                           class="form-check-input row-checkbox">
                                </td>

                                <td class="position-title">
                                    <a asp-action="GetPositionDetail" asp-controller="Position" asp-route-positionId=@item.Id>@item.Title</a>
                                </td>
                                <td>@item.Description</td>
                                <td>@item.Level</td>
                                <td class="position-permissions">@item.Permissions</td>
                                <td >@item.Status</td>
                                <td>@item.MaxProjects</td>
                                <td>@item.CreatedOn.ToString("yyyy-MM-dd")</td>
                                <td>@item.ClosedAt?.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center">
                                <p class="h3 my-3">There are no positions</p>
                            </td>
                        </tr>
                    }

                    <tr id="noSearchResults" style="display: none;">
                        <td colspan="9" class="text-center">
                            <p class="h3 my-3">No positions found</p>
                        </td>
                    </tr>

                    </tbody>
                </table>
            </div>
        </div>
    </form>
</div>

@await Html.PartialAsync("_CreatePosition", Model.CreatePositionDto)

<div id="editModalContainer"></div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } 

    <script>
    const selectAll = document.getElementById('selectAll');
    const rowCheckboxes = document.querySelectorAll('.row-checkbox');

    const toolbarBtns = [
        document.getElementById('btnEdit'),
        document.getElementById('btnDuplicate'),
        document.getElementById('btnDelete'),
        document.getElementById('btnTemplate')
    ].filter(Boolean);

    function updateToolbar() {
        const checked = Array.from(rowCheckboxes).filter(cb => cb.checked);
        const any = checked.length > 0;

        toolbarBtns.forEach(btn => {
            btn.disabled = !any;
        });

        const editBtn = document.getElementById('btnEdit');
        const duplicateBtn = document.getElementById('btnDuplicate');
        const templateBtn = document.getElementById('btnTemplate');

        if (editBtn) {
            editBtn.disabled = checked.length !== 1;
        }

        if (duplicateBtn) {
            duplicateBtn.disabled = checked.length !== 1;
        }

        if (templateBtn) {
            templateBtn.disabled = checked.length !== 1;
        }
    }

    if (selectAll) {
        selectAll.addEventListener('change', function () {
            rowCheckboxes.forEach(cb => {
                const row = cb.closest('tr');

                if (row && !row.hidden) {
                    cb.checked = this.checked;
                    row.classList.toggle('table-active', this.checked);
                }
            });

            updateToolbar();
        });
    }

    rowCheckboxes.forEach(cb => {
        cb.addEventListener('change', function () {
            const row = this.closest('tr');

            if (row) {
                row.classList.toggle('table-active', this.checked);
            }

            const visibleCheckboxes = Array.from(rowCheckboxes).filter(c => {
                const checkboxRow = c.closest('tr');
                return checkboxRow && !checkboxRow.hidden;
            });

            if (selectAll) {
                selectAll.checked =
                    visibleCheckboxes.length > 0 &&
                    visibleCheckboxes.every(c => c.checked);
            }

            updateToolbar();
        });
    });

    window.addEventListener('pageshow', e => {
        if (e.persisted) {
            rowCheckboxes.forEach(cb => {
                cb.checked = false;
                const row = cb.closest('tr');
                if (row) {
                    row.classList.remove('table-active');
                }
            });

            if (selectAll) {
                selectAll.checked = false;
            }

            updateToolbar();
        }
    });

    const editBtn = document.getElementById('btnEdit');

    if (editBtn) {
        editBtn.addEventListener('click', async () => {
            const selected = document.querySelector('.row-checkbox:checked');

            if (!selected) {
                return;
            }

            const id = selected.value;
            const response = await fetch(
                `/Position/EditPositionForm?id=${encodeURIComponent(id)}`
            );

            if (!response.ok) {
                console.error('Failed to load edit form');
                return;
            }

            const editModalContainer =
                document.getElementById('editModalContainer');

            if (!editModalContainer) {
                return;
            }

            editModalContainer.innerHTML = await response.text();

            const form = document.getElementById('editPositionForm');

            if (form && window.$ && $.validator && $.validator.unobtrusive) {
                $.validator.unobtrusive.parse(form);
            }

            const editModal =
                document.getElementById('editPositionModal');

            if (editModal && window.bootstrap) {
                bootstrap.Modal.getOrCreateInstance(editModal).show();
            }
        });
    }

    updateToolbar();
    </script>
}