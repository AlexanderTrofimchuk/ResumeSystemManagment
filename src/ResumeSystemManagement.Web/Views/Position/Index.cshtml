@using Microsoft.AspNetCore.Http.Features
@using ResumeSystemManagement.Core.ReadModels
@model ResumeSystemManagement.Application.DTOs.Position.PositionDetails
@{
    ViewData["Title"] = "Position Library";
}

<div class="container mx-auto justify-content-center align-items-center mt-2 robot-mono-font um-container">

    <div class="toolbar d-flex align-items-center gap-2 p-2 mb-3 border rounded bg-light shadow-sm um-toolbar">

        <form asp-controller="PositionLibrary"
              asp-action="SearchPosition"
              method="get"
              class="d-flex gap-2 flex-grow-1">

            <input type="text"
                   name="name"
                   class="form-control form-control-sm"
                   placeholder="Search by title or description..."
                   aria-label="Search positions"
                   value="@Context.Request.Query["name"]">

            <button type="submit"
                    class="btn btn-outline-secondary btn-sm flex-shrink-0"
                    title="Search">
                <i class="bi bi-search"></i>
            </button>

        </form>
        
        @if (User.IsInRole(RoleNames.Recruiter))
        {
            <button
                id="btnCreate"
                class="btn btn-outline-primary btn-sm"
                title="Create position"
                data-bs-toggle="modal"
                data-bs-target="#createPositionModal">
                <span class="btn-text"><i class="bi bi-plus-square-fill"></i></span>
            </button>
            
            <button asp-action="DuplicatePosition"
                    type="submit"
                    form="mainForm"
                    id="btnDuplicate"
                    class="btn btn-outline-warning btn-sm"
                    disabled
                    title="Duplicate position">
                <i class="bi bi-copy"></i>
            </button>
            
            <button
                id="btnEdit"
                class="btn btn-outline-secondary btn-sm"
                disabled
                title="Edit position">
                <i class="bi bi-pencil-fill"></i>
            </button>

            <button asp-action="DeletePositions"
                    type="submit"
                    form="mainForm"
                    id="btnDelete"
                    class="btn btn-outline-danger btn-sm"
                    disabled
                    title="Delete position/positions">
                <i class="bi bi-dash-square-fill"></i>
            </button>
        }

    </div>

    <form method="post" id="mainForm">
        <div class="um-table-wrapper">
            <div class="um-scroll-area">
                <table class="table table-striped-columns um-table text-center">
                    <thead>
                    <tr>
                        <th scope="col">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="selectAll"
                                   id="selectAll"
                                   aria-label="Select All">
                        </th>
                        <th scope="col">Title</th>
                        <th scope="col">Description</th>
                        <th scope="col">Permissions</th>
                        <th scope="col">Created On</th>
                    </tr>
                    </thead>

                    <tbody id="positionTableBody">
                    @if (Model.Positions.Count > 0)
                    {
                        @foreach (var item in Model.Positions)
                        {
                            <tr class="position-row">
                                <td>
                                    <input value="@item.Id"
                                           name="SelectIds"
                                           id="checkbox-@item.Id"
                                           type="checkbox"
                                           class="form-check-input row-checkbox">
                                </td>

                                <td class="position-title">@item.Title</td>
                                <td>@item.Description</td>
                                <td class="position-permissions">@item.Permissions</td>
                                <td>@item.CreatedOn.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center">
                                <p class="h3 my-3">There are no positions</p>
                            </td>
                        </tr>
                    }

                    <tr id="noSearchResults" style="display: none;">
                        <td colspan="5" class="text-center">
                            <p class="h3 my-3">No positions found</p>
                        </td>
                    </tr>

                    </tbody>
                </table>
            </div>
        </div>
    </form>
</div>

@await Html.PartialAsync("_CreatePosition", Model.CreatePositionDto)

<div id="editModalContainer"></div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
    const selectAll     = document.getElementById('selectAll');
    const rowCheckboxes = document.querySelectorAll('.row-checkbox');

    const toolbarBtns = [
        document.getElementById('btnEdit'),
        document.getElementById('btnDuplicate'),
        document.getElementById('btnDelete'),
    ];

    function updateToolbar() {
        const checked = Array.from(rowCheckboxes).filter(cb => cb.checked);
        const any = checked.length > 0;

        toolbarBtns.forEach(btn => {
            if (btn) btn.disabled = !any;
        });

        const editBtn = document.getElementById('btnEdit');
        const duplicateBtn = document.getElementById('btnDuplicate');
        if (editBtn && duplicateBtn) {
            editBtn.disabled = checked.length !== 1;
            duplicateBtn.disabled = checked.length !== 1;
        }
    }

    selectAll.addEventListener('change', function () {
        rowCheckboxes.forEach(cb => {
            if (!cb.closest('tr').hidden) {
                cb.checked = this.checked;
                cb.closest('tr').classList.toggle('table-active', this.checked);
            }
        });

        updateToolbar();
    });

    rowCheckboxes.forEach(cb => {
        cb.addEventListener('change', function () {
            this.closest('tr').classList.toggle('table-active', this.checked);

            const visibleCheckboxes = Array.from(rowCheckboxes)
                .filter(c => !c.closest('tr').hidden);

            selectAll.checked =
                visibleCheckboxes.length > 0 &&
                visibleCheckboxes.every(c => c.checked);

            updateToolbar();
        });
    });

    document.getElementById('btnEdit').addEventListener('click', async () => {
        const id = document.querySelector('.row-checkbox:checked').value;
        const response = await fetch(`/PositionLibrary/EditPositionForm?id=${id}`);

        if (!response.ok) return console.error('Failed to load edit form');

        document.getElementById('editModalContainer').innerHTML = await response.text();

        bootstrap.Modal.getOrCreateInstance(
            document.getElementById('editPositionModal')
        ).show();
    });

    window.addEventListener('pageshow', e => {
        if (e.persisted) {
            rowCheckboxes.forEach(cb => cb.checked = false);
            updateToolbar();
        }
    });

    document.getElementById('btnEdit').addEventListener('click', async () => {
        const id = document.querySelector('.row-checkbox:checked').value;
        const response = await fetch(`/Position/EditPositionForm?id=${id}`);

        if (!response.ok) return console.error('Failed to load edit form');

        document.getElementById('editModalContainer').innerHTML = await response.text();

        const form = document.getElementById('editPositionForm');
        $.validator.unobtrusive.parse(form);

        bootstrap.Modal.getOrCreateInstance(
            document.getElementById('editPositionModal')
        ).show();
    });
    </script>
}
