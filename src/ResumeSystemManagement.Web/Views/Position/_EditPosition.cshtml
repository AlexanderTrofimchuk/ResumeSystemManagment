@model ResumeSystemManagement.Application.DTOs.Position.EditPositionDto

<div class="modal fade" id="editPositionModal" tabindex="-1"
     aria-labelledby="editPositionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <div class="modal-header border-bottom px-4 py-3">
                <h5 class="modal-title fw-semibold" id="editPositionModalLabel">
                    Edit Position
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="EditPosition" method="post" novalidate id="editPositionForm">
                <div class="modal-body px-4 py-4">

                    <input asp-for="Id" type="hidden" />
                    <input asp-for="CreatedOn" type="hidden" />
                    <input asp-for="Version" type="hidden">
                    <input asp-for="CreatedBy" type="hidden">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger py-2 small mb-3" role="alert"></div>
                    
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-medium">
                            Title <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Title"
                               class="form-control"
                               placeholder="Enter position title"
                               autocomplete="off" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-medium">Description</label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Brief description (optional)"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="MaxProject" class="form-label fw-medium">
                            Max projects <span class="text-danger">*</span>
                        </label>
                        <input asp-for="MaxProject"
                               type="number"
                               min="0"
                               step="1"
                               class="form-control"
                               placeholder="Maximum number of projects" />
                        <div class="form-text ms-1">Maximum number of projects allowed for this position.</div>
                        <span asp-validation-for="MaxProject" class="text-danger small"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Level" class="form-label fw-medium">Level</label>
                        <select asp-for="Level"
                                asp-items="Html.GetEnumSelectList<ResumeSystemManagement.Core.Enums.PositionLevel>()"
                                class="form-select">
                        </select>
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    
                    <div class="mb-1">
                        <label asp-for="Permissions" class="form-label fw-medium">Permissions</label>
                        <select asp-for="Permissions"
                                asp-items="Html.GetEnumSelectList<ResumeSystemManagement.Core.Enums.PositionPermissions>()"
                                class="form-select">
                        </select>
                        <div class="form-text ms-1">Controls who can see and use this position.</div>
                        <span asp-validation-for="Permissions" class="text-danger small"></span>
                    </div>

                </div>

                <div class="modal-footer border-top px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i> Save
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
