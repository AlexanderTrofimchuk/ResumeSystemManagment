@using ResumeSystemManagement.Core.Enums
@model ResumeSystemManagement.Application.DTOs.PositionTemplate.PositionTemplateDTo

@{
    ViewData["Title"] = "Position Template";

    var typeIcons = new Dictionary<string, string>
    {
      { "String",      "bi-type" },
      { "Text",        "bi-text-left" },
      { "Image",       "bi-image" },
      { "Numeric",     "bi-123" },
      { "Date",        "bi-calendar3" },
      { "Period",      "bi-calendar-range" },
      { "Boolean",     "bi-toggle-on" },
      { "One of many", "bi-menu-button-wide" }
    };
}

@section Styles
{
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>

  <style>
    .library-panel { position: sticky; top: 1rem; }
    .lib-list      { max-height: 420px; overflow-y: auto; }
    .lib-item.already-added { opacity: .4; pointer-events: none; }
    .section-toggle.collapsed { transform: rotate(-90deg); }
    .order-btns { display: flex; flex-direction: column; }
  </style>
}

<!-- Topbar -->
<nav class="navbar navbar-light bg-white border-bottom px-3 py-2">
  <div class="d-flex align-items-center gap-3">
    <span class="navbar-brand fw-bold mb-0">
      <i class="bi bi-file-earmark-person me-2 text-primary"></i>Position Editor
    </span>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0 small">
        <li class="breadcrumb-item"><a href="#" class="text-muted text-decoration-none">Positions</a></li>
        <li class="breadcrumb-item active">@Model.PositionTitle</li>
      </ol>
    </nav>
  </div>
  <div class="d-flex gap-2">
    
    <span class="badge @(Model.PublishStatus == PublishStatus.Publish
                         ? "bg-success"
                         : "bg-secondary")">Status
      @(Model.PublishStatus == PublishStatus.Publish ? "Published" : "Draft")
    </span>

    <a class="btn btn-sm btn-primary"
       asp-action="PublishPosition"
       asp-controller="PositionTemplate"
       asp-route-id="@Model.PositionId"
       disabled="@(Model.PublishStatus == PublishStatus.Publish)">
      <i class="bi bi-check2 me-1"></i>
      @(Model.PublishStatus == PublishStatus.Publish ? "Published" : "Publish")
    </a>
    <a class="btn btn-sm btn-primary"
       asp-action="DraftPosition"
       asp-controller="PositionTemplate"
       asp-route-id="@Model.PositionId"
       disabled="@(Model.PublishStatus == PublishStatus.Draft)">
      <i class="bi bi-check2 me-1"></i>
      Move to Draft
    </a>
  </div>
</nav>

<!-- Layout -->
<div class="container-fluid p-3">
  <div class="row g-3 align-items-start">

    <!-- LEFT: Library -->
    <div class="col-md-4 col-lg-3">
      <div class="card library-panel">
        <div class="card-header bg-light fw-semibold small text-uppercase text-secondary">
          <i class="bi bi-collection me-2"></i>Attribute Library
        </div>

        <!-- Search -->
        <div class="card-body p-2 border-bottom">
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
            <input type="text" class="form-control border-start-0" id="libSearch" placeholder="Search...">
          </div>
        </div>

        <div class="card-body p-2 border-bottom d-flex flex-wrap gap-1" id="filterBtns">
        </div>

        <div class="list-group list-group-flush lib-list" id="libraryList">
        </div>
      </div>
    </div>

    <!-- RIGHT: Template -->
    <div class="col-md-8 col-lg-9">
      <div class="card">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
          <span class="fw-semibold small text-uppercase text-secondary">
            <i class="bi bi-layout-text-sidebar-reverse me-2"></i>Template Structure
          </span>
          <span class="badge bg-primary" id="totalCount">@Model.AttributeInPosition.Sum(ap => ap.AttributeTemplates.Count)</span>
        </div>
        <div id="templateSections">
          @foreach (var sectionPosition in Enum.GetValues<TemplateSection>())
          {
            var items = Model.GetAttributes(sectionPosition);
            var icon  = sectionPosition.GetDisplayIcon();
            var label = sectionPosition.GetDisplayName();
            var secId = (int)sectionPosition;

            <div class="border-bottom" id="sec-@secId">
              <!-- Section header -->
              <div class="d-flex align-items-center justify-content-between px-3 py-2 bg-light"
                   style="cursor:pointer" onclick="toggleSection('@secId')">
                  <div class="d-flex align-items-center gap-2 fw-semibold small">
                      <i class="bi @icon text-secondary"></i>
                      @label
                      <span class="badge bg-secondary bg-opacity-25 text-secondary fw-normal"
                            style="font-size:.65rem">
                          @(items.Any() ? $"{items.Count} attr." : "empty")
                      </span>
                  </div>
                  <i class="bi bi-chevron-down text-secondary small section-toggle" id="toggle-@secId"></i>
              </div>

              <!-- Attributes -->
              <div id="list-@secId">
                @if (!items.Any())
                {
                  <div class="text-muted small text-center fst-italic py-3">
                    <i class="bi bi-plus-circle me-1"></i>Add attributes from the library
                  </div>
                }
                else
                {
                  @for (int i = 0; i < items.Count; i++)
                  {
                    var attr = items[i];
                    <div class="d-flex align-items-center gap-2 px-3 py-2 border-bottom bg-white">

                      <!-- Up / Down buttons -->
                      <div class="order-btns">
                        <form asp-action="ReorderAttribute" asp-controller="Position" method="post">
                          <input type="hidden" name="positionId" value="@Model.PositionId"/>
                          <input type="hidden" name="attributeId" value="@attr.Id"/>
                          <input type="hidden" name="section"     value="@sectionPosition"/>
                          <input type="hidden" name="direction"   value="-1"/>
                          <button class="btn btn-sm btn-outline-secondary border-0 py-0 px-1 lh-1"
                                  @(i == 0 ? "disabled" : "") title="Move up">
                            <i class="bi bi-chevron-up" style="font-size:.7rem"></i>
                          </button>
                        </form>
                        <form asp-action="ReorderAttribute" asp-controller="Position" method="post">
                          <input type="hidden" name="positionId" value="@Model.PositionId"/>
                          <input type="hidden" name="attributeId" value="@attr.Id"/>
                          <input type="hidden" name="section"     value=@sectionPosition />
                          <input type="hidden" name="direction"   value="1"/>
                          <button class="btn btn-sm btn-outline-secondary border-0 py-0 px-1 lh-1"
                                  @(i == items.Count - 1 ? "disabled" : "") title="Move down">
                            <i class="bi bi-chevron-down" style="font-size:.7rem"></i>
                          </button>
                        </form>
                      </div>

                      <!-- Name -->
                      <div class="flex-grow-1">
                        <div class="small">@attr.Name</div>
                      </div>

                      <!-- Type badge -->
                      <span class="badge bg-light text-secondary border" style="font-size:.65rem">
                        <i class="bi @(typeIcons.GetValueOrDefault(attr.TypeName, "bi-question-circle"))"></i>
                        @attr.TypeName
                      </span>

                      <!-- Move to another section -->
                      <button class="btn btn-sm btn-outline-secondary border-0 py-0 px-1"
                              data-bs-toggle="modal"
                              data-bs-target="#moveSectionModal"
                              data-attr-id="@attr.Id"
                              data-from-section="@sectionPosition"
                              title="Move to section">
                        <i class="bi bi-arrows-move"></i>
                      </button>

                      <!-- Remove -->
                      <form asp-action="RemoveAttribute" asp-controller="PositionTemplate" method="post">
                        <input type="hidden" name="positionId"  value="@Model.PositionId"/>
                        <input type="hidden" name="attributeId" value="@attr.Id"/>
                        <input type="hidden" name="section"     value="@sectionPosition"/>
                        <button class="btn btn-sm btn-outline-danger border-0 py-0 px-1" title="Remove">
                          <i class="bi bi-x-lg"></i>
                        </button>
                      </form>

                    </div>
                  }
                }
              </div>
            </div>
          }
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Modal: choose section when adding -->
<div class="modal fade" id="addToSectionModal" tabindex="-1">
  <div class="modal-dialog modal-sm modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title">Add to Section</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form asp-action="AddAttribute" asp-controller="PositionTemplate" method="post">
          <input type="hidden" name="positionId"  value="@Model.PositionId"/>
          <input type="hidden" name="attributeId" id="modalAttrId"/>
          <input type="hidden" name="section"     id="modalSection"/>

          @foreach (var sec in Enum.GetValues<TemplateSection>())
          {
            <button type="button"
                    class="btn btn-outline-secondary w-100 text-start mb-2 d-flex align-items-center gap-2"
                    onclick="selectSection(@((int)sec),'modalSection','addSubmitBtn')">
              <i class="bi @sec.GetDisplayIcon() text-primary"></i>
              <span>@sec.GetDisplayName()</span>
              <span class="ms-auto text-muted small">
                @(Model.GetAttributes(sec).Count) attr.
              </span>
            </button>
          }

          <button type="submit" class="btn btn-primary w-100 mt-1" id="addSubmitBtn" disabled>
            Add
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Modal: move to another section -->
<div class="modal fade" id="moveSectionModal" tabindex="-1">
  <div class="modal-dialog modal-sm modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title">Move to Section</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="moveSectionChoices">
        <form asp-action="MoveAttribute" asp-controller="PositionTemplate" method="post">
          <input type="hidden" name="positionId"  value="@Model.PositionId"/>
          <input type="hidden" name="attributeId" id="moveModalAttrId"/>
          <input type="hidden" name="moveSection" id="moveModalSection"/>

          @foreach (var sec in Enum.GetValues<TemplateSection>())
          {
            <button type="button"
                    class="btn btn-outline-secondary w-100 text-start mb-2 d-flex align-items-center gap-2"
                    onclick="selectSection(@((int)sec),'moveModalSection','moveSubmitBtn')">
              <i class="bi @sec.GetDisplayIcon() text-primary"></i>
              <span>@sec.GetDisplayName()</span>
              <span class="ms-auto text-muted small">
                @(Model.GetAttributes(sec).Count) attr.
              </span>
            </button>
          }

          <button type="submit" class="btn btn-primary w-100 mt-1" id="moveSubmitBtn" disabled>
            Move
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

@section Scripts{
  <script>
    function openModal(modal, attrId, section, btn) {
      document.getElementById(modal).addEventListener('show.bs.modal', e => {
        document.getElementById(attrId).value = e.relatedTarget.dataset.attrId;
        document.getElementById(section).value = '';
        document.getElementById(btn).disabled = true;
      });
    }

    function selectSection(sectionId, modalSectionId, btnId) {
      document.getElementById(modalSectionId).value = sectionId;
      document.getElementById(btnId).disabled = false;
    }

    async function loadLibrary(positionId) {
      const html = await fetch(`/PositionTemplate/GetAttributeLibrary?page=1&pageSize=10&positionId=${positionId}`)
        .then(r => r.text());
      document.getElementById('libraryList').innerHTML = html;
    }

    async function loadTypes() {
      const html = await fetch(`/PositionTemplate/GetAttributeTypes`)
        .then(r => r.text());
      document.getElementById('filterBtns').innerHTML = html;
    }

    document.addEventListener('DOMContentLoaded', async () => {
      await loadLibrary(@Model.PositionId);
      await loadTypes();

      openModal('addToSectionModal',  'modalAttrId',     'modalSection',     'addSubmitBtn');
      openModal('moveSectionModal',   'moveModalAttrId', 'moveModalSection', 'moveSubmitBtn');
    });

    document.getElementById('filterBtns').addEventListener('click', e => {
      const btn = e.target.closest('button[data-type]');
      if (!btn) return;
      document.querySelectorAll('#filterBtns button').forEach(b => {
        b.className = 'btn btn-outline-secondary btn-sm rounded-pill';
      });
      btn.className = 'btn btn-primary btn-sm rounded-pill';
    });

    document.getElementById('libSearch').addEventListener('input', e => {
      searchQuery = e.target.value;
      renderLibrary();
    });
  </script>
}
