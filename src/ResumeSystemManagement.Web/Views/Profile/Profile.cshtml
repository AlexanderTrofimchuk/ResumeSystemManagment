@using System.Text.Json
@using Microsoft.AspNetCore.Mvc.Localization
@model ResumeSystemManagement.Application.DTOs.User.ProfileDetail
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"];
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/easymde/dist/easymde.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
}

<div class="container-xl py-4">
    @Html.AntiForgeryToken()
    <button type="button" class="btn btn-primary mb-3" id="openCreateSalesForceForm">
        <i class="bi bi-cloud-plus me-1"></i> @Localizer["CreateSalesforceAccount"]
    </button>
    <div id="createSalesForceFormContainer"></div>
    <!-- ── Me ─────────────────────────────────────────────────── -->
    <div class="card mb-4" id="section-me">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h5 class="mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-person-fill text-primary"></i> @Localizer["Me"]
            </h5>
        </div>
        <div class="card-body">
                @if (Model.MeSectorAttributes.Any())
                {
                    foreach (var attr in Model.MeSectorAttributes)
                    {
                       @await Html.PartialAsync("_AttributeField", attr)
                    }
                }
        </div>
    </div>

    <!-- ── Info ───────────────────────────────────────────────── -->
    <div class="card mb-4" id="section-info">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h5 class="mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-info-circle-fill text-primary"></i> @Localizer["Info"]
            </h5>
            <div class="d-flex gap-2">
                <button type="button"
                        class="btn btn-sm btn-outline-danger"
                        id="deleteSelectedAttributes"
                        disabled>
                    <i class="bi bi-trash me-1"></i> @Localizer["DeleteSelectedAttributes"]
                </button>
                <button class="btn btn-sm btn-primary"
                        id="openAddAttributeModal">
                    <i class="bi bi-plus-lg"></i> @Localizer["AddAttribute"]
                </button>
            </div>
        </div>
        <div class="card-body">
            <div id="infoAttributes">
            @if(Model.InfoSectorAttributes.Any())
            {
                foreach (var attr in Model.InfoSectorAttributes)
                {
                <div class="info-attribute d-flex align-items-start gap-2">
                    <input type="checkbox"
                           class="form-check-input info-attribute-select mt-2"
                           aria-label="@Localizer["SelectInfoAttribute"]"
                           data-record-id="@attr.Id" />
                    <div class="flex-grow-1">
                        @await Html.PartialAsync("_AttributeField", attr)
                    </div>
                </div>
            }
        }
            else
            {
                <div id="infoEmptyState" class="text-center py-5 text-secondary">
                    <i class="bi bi-collection fs-2 d-block mb-2"></i>
                    <p class="mb-0 small">@Localizer["NoAttributesYet"]<br />@Localizer["ClickToPickAttributes"]</p>
                </div>
            }
            </div>
        </div>
    </div>

</div>

<div id="addAttributeModalContainer"></div>

@section Scripts {
    <script src="https://unpkg.com/easymde/dist/easymde.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script id="profile-config" type="application/json">
        @Html.Raw(JsonSerializer.Serialize(new
        {
            urls = new
            {
                saveMe = Url.ActionLink("MeSectorSave", "Profile"),
                saveInfo = Url.Action("InfoSectorSave", "Profile"),
                createForm = Url.Action("CreateForm", "Profile"),
                attributeLibrary = Url.ActionLink("GetAttributeLibrary", "Profile", new { page = 1 }),
                addAttribute = Url.Action("AddAttributeInfo", "Profile"),
                deleteAttributes = Url.Action("DeleteAttributeInfo", "Profile")
            },
            messages = new
            {
                saveFailed = Localizer["ProfileSaveFailed"].Value,
                loadSalesforceFailed = Localizer["LoadSalesforceFailed"].Value,
                selectAttribute = Localizer["SelectAttribute"].Value,
                addAttributesFailed = Localizer["AddAttributesFailed"].Value,
                deleteAttributeFailed = Localizer["DeleteAttributeFailed"].Value,
                confirmDeleteAttributes = Localizer["ConfirmDeleteSelectedAttributes"].Value,
                noAttributesYet = Localizer["NoAttributesYet"].Value,
                clickToPickAttributes = Localizer["ClickToPickAttributes"].Value
            }
        }))
    </script>
    <script type="module" src="~/js/profile.js" asp-append-version="true"></script>
}
