@using ResumeSystemManagement.Application.DTOs.Attributes
@using Microsoft.AspNetCore.Mvc.Localization
@model List<AttributeTemplate>
@inject IViewLocalizer Localizer

<div class="modal fade" id="modalAddAttribute" tabindex="-1" aria-labelledby="modalAddAttributeLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalAddAttributeLabel">
                    <i class="bi bi-collection me-1 text-primary"></i> @Localizer["AddAttribute"]
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
            </div>
            <div class="modal-body">
                @Html.AntiForgeryToken()
                <div class="input-group mb-3">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="@Localizer["SearchAttributeLibrary"]" />
                </div>
                <p class="text-muted small mb-2">@Localizer["AvailableAttributes"]</p>
                <div class="list-group list-group-flush">
                    @if (Model.Count == 0)
                    {
                        <p class="text-muted mb-0">@Localizer["NoAttributesAvailable"]</p>
                    }
                    else
                    {
                        @foreach (var attr in Model)
                        {
                            <label class="list-group-item list-group-item-action d-flex align-items-center gap-2">
                                <input type="checkbox"
                                       class="form-check-input m-0 attribute-option"
                                       value="@attr.Id"
                                       data-name="@attr.Name"
                                       data-description="@attr.Description"
                                       data-type-name="@attr.TypeName" />
                                <span>@attr.Name</span>
                                @if (!string.IsNullOrWhiteSpace(attr.TypeName))
                                {
                                    <span class="badge text-bg-secondary ms-auto fw-normal">@attr.TypeName</span>
                                }
                            </label>
                        }
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="button" class="btn btn-primary" id="addSelectedAttributes">@Localizer["AddSelected"]</button>
            </div>
        </div>
    </div>
</div>
