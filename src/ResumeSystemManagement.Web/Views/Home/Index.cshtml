@model ResumeSystemManagement.Application.DTOs.Statistic.StaticticeDto?

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-4">
    <!-- ========================= -->
    <!-- Statistics -->
    <!-- ========================= -->
    <section class="mb-4" aria-labelledby="statistics-title">
        <div class="row g-3">

            <!-- Total Positions -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card statistics-card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="statistics-label text-muted mb-2">
                                    Total Positions
                                </div>

                                <div class="statistics-value">
                                    @(Model?.TotalPositions ?? 0)
                                </div>
                            </div>

                            <div class="statistics-icon" aria-hidden="true">
                                <i class="bi bi-briefcase"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Candidates -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card statistics-card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="statistics-label text-muted mb-2">
                                    Candidates
                                </div>

                                <div class="statistics-value">
                                    @(Model?.TotalCandidates ?? 0)
                                </div>
                            </div>

                            <div class="statistics-icon" aria-hidden="true">
                                <i class="bi bi-people"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>


    <!-- ========================= -->
    <!-- Positions -->
    <!-- ========================= -->
    <div class="row g-4 mb-4">

        <!-- Latest Positions -->
        <div class="col-12 col-xl-8">
            <section class="card border-0 shadow-sm h-100">

                <div class="card-header bg-transparent border-0 p-4 pb-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h5 mb-1">
                                Latest Positions
                            </h2>
                            <p class="text-muted small mb-0">
                                Recently created or updated positions.
                            </p>
                        </div>

                        <a asp-controller="Position"
                           asp-action="Index"
                           class="btn btn-sm btn-outline-secondary">
                            View all
                            <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="px-4">Position</th>
                                    <th>Level</th>
                                    <th>Updated</th>
                                </tr>
                            </thead>

                            <tbody>
                            @if (Model?.LatestPositions != null && Model.LatestPositions.Any())
                            {
                                foreach (var position in Model.LatestPositions)
                                {
                                    <tr>
                                        <td class="px-4">
                                            <div class="fw-semibold">
                                                @position.Title
                                            </div>
                                        </td>
                                        <td>
                                            @position.Level
                                        </td>
                                        <td class="text-muted">
                                            @(position.Created.ToString("dd.MM.yyyy HH:mm") ?? "—")
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-5">
                                        <i class="bi bi-inbox fs-3 d-block mb-2"
                                           aria-hidden="true"></i>
                                        No positions found.
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>

            </section>
        </div>


        <!-- Most Popular Positions -->
        <div class="col-12 col-xl-4">
            <section class="card border-0 shadow-sm h-100">

                <div class="card-header bg-transparent border-0 p-4 pb-2">
                    <div>
                        <h2 class="h5 mb-1">
                            Most Popular Positions
                        </h2>
                        <p class="text-muted small mb-0">
                            Top 5 positions by submitted CVs.
                        </p>
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="px-4">Position</th>
                                    <th class="text-end pe-4">CVs</th>
                                </tr>
                            </thead>

                            <tbody>
                            @if (Model?.MostPopularPositions != null && Model.MostPopularPositions.Any())
                            {
                                foreach (var position in Model.MostPopularPositions)
                                {
                                    <tr>
                                        <td class="px-4">
                                            <div class="fw-semibold">
                                                @position.Title
                                            </div>
                                        </td>

                                        <td class="text-end pe-4">
                                            <span class="badge text-bg-light">
                                                @position.SubmittedCvs
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="text-center text-muted py-5">
                                        <i class="bi bi-inbox fs-3 d-block mb-2"
                                           aria-hidden="true"></i>
                                        No data found.
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>

            </section>
        </div>

    </div>

</div>


@section Styles
{
    <style>
    .statistics-card {
        border-radius: 14px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .statistics-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.75rem 1.5rem rgba(0, 0, 0, 0.08) !important;
    }

    .statistics-label {
        font-size: 0.85rem;
        font-weight: 600;
    }

    .statistics-value {
        font-size: 2rem;
        font-weight: 700;
        line-height: 1.1;
    }

    .statistics-icon {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background-color: var(--bs-light);
        font-size: 1.35rem;
        flex-shrink: 0;
    }

    .statistics-header-icon {
        font-size: 1.4rem;
        color: var(--bs-secondary-color);
    }

    .table > :not(caption) > * > * {
        padding-top: 0.9rem;
        padding-bottom: 0.9rem;
    }
</style>
}